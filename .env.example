# Do not change the DOMAIN after people start following this account.
DOMAIN=social.example.com
# A loopback-only host port for cloudflared installed on the same machine.
LOCAL_PORT=80

# Fresh installations use index.php. Preserve your old actor path after federation starts.
FEDERATION_PATH=/index.php

# --- Deployment mode (pick ONE; default is Cloudflare Tunnel) ---
# Default (both 0/absent): cloudflared on the host reaches Caddy at
#   http://localhost:LOCAL_PORT and Cloudflare provides public HTTPS.
#
# TRUST_PROXY=1
#   Another TLS-terminating reverse proxy (nginx, Traefik, a cloudflared
#   container, ...) sits in front of Caddy and sends X-Forwarded-Proto: https.
#
# ALLOW_INSECURE_HTTP=1
#   Direct plain-HTTP access with NO proxy at all (http://localhost:8080 on
#   your own machine or LAN). Login cookies are issued without the Secure
#   flag in this mode. NEVER expose this on the public Internet.
TRUST_PROXY=0
ALLOW_INSECURE_HTTP=0

# Required for first account creation only; install.sh generates a private token.
XFEDI_SETUP_TOKEN=
